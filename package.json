{
  "name": "dsh-llm-resilience",
  "version": "0.5.1",
  "description": "Provider-level retry, fallback chains and persistent circuit breaking for DeepSeek Harness LLM routes — built for gateways that intermittently break tool-call streams or connections.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "llm",
    "retry",
    "fallback",
    "failover",
    "circuit-breaker",
    "resilience"
  ],
  "license": "MIT",
  "author": "T-splines",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-splines/dsh-llm-resilience.git"
  },
  "homepage": "https://github.com/T-splines/dsh-llm-resilience#readme",
  "bugs": {
    "url": "https://github.com/T-splines/dsh-llm-resilience/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  }
}
